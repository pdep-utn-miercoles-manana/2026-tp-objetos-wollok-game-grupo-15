import wollok.game.*
import src.restauranteEntorno.*
import src.personajeComportamiento.*
import src.menuPartida.*
import src.vidasComportamiento.*
import src.temporizador.*
program juego {
    game.title("Restorante")
    game.width(26)
    game.height(16)
    game.cellSize(50)
    game.boardGround("piso2.png")

    restaurante.iniciar()
    menu.iniciar()
    game.addVisual(vidas)
    game.addVisual(cartelMonedas)
    jugador.iniciar()
    temporizador.iniciar()

    game.start()
}

