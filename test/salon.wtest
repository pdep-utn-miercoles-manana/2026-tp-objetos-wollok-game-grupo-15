import src.estadosEspera.*
import src.clienteComportamiento.*
import src.restauranteEntorno.*
import src.comidasComportamiento.*

describe "Mesa" {
    const pedidoCarne = new Pedido(comidaPedida = carne)
    const pedidoCerdo = new Pedido(comidaPedida = cerdo)
    const mesa = new Mesa(position = game.at(0, 0))
    const grupoDeUno = new Grupo(pedidos = [pedidoCarne])
    const grupoDeDos = new Grupo(pedidos = [pedidoCarne, pedidoCerdo])

    test "una mesa nueva está libre" {
        assert.notThat(mesa.ocupada())
    }

    test "al sentar un grupo, la mesa queda ocupada" {
        mesa.sentar(grupoDeUno)
        assert.that(mesa.ocupada())
    }

    test "no se puede sentar un grupo en una mesa ocupada" {
        mesa.sentar(grupoDeUno)
        assert.throwsExceptionWithMessage("La mesa ya está ocupada", { mesa.sentar(grupoDeDos) })
    }

    test "en la mesa entra un grupo de cuatro personas" {
        mesa.sentar(new Grupo(pedidos = [pedidoCarne, pedidoCarne, pedidoCarne, pedidoCarne]))
        assert.that(mesa.ocupada())
    }

    test "no entra un grupo de más de cuatro personas" {
        const grupoGrande = new Grupo(pedidos = [pedidoCarne, pedidoCarne, pedidoCarne, pedidoCarne, pedidoCarne])
        assert.throwsExceptionWithMessage("No entran tantas personas en la mesa", { mesa.sentar(grupoGrande) })
    }

    test "una mesa libre no quiere ninguna comida" {
        assert.notThat(mesa.quiere(carne.copiarEn(game.at(0, 0))))
    }

    test "una mesa ocupada quiere lo que pidió su grupo" {
        mesa.sentar(grupoDeDos)
        assert.that(mesa.quiere(carne.copiarEn(game.at(0, 0))))
        assert.that(mesa.quiere(cerdo.copiarEn(game.at(0, 0))))
        assert.notThat(mesa.quiere(pollo.copiarEn(game.at(0, 0))))
    }

    test "servir devuelve la propina y la mesa sigue ocupada si faltan pedidos" {
        mesa.sentar(grupoDeDos)
        const propina = mesa.servir(carne.copiarEn(game.at(0, 0)))
        assert.equals(verde.propina(), propina)
        assert.that(mesa.ocupada())
    }

    test "al servir el último pedido, la mesa se libera" {
        mesa.sentar(grupoDeDos)
        mesa.servir(carne.copiarEn(game.at(0, 0)))
        mesa.servir(cerdo.copiarEn(game.at(0, 0)))
        assert.notThat(mesa.ocupada())
    }

    test "no se puede servir en una mesa libre" {
        assert.throwsExceptionWithMessage("No hay nadie en la mesa", { mesa.servir(carne.copiarEn(game.at(0, 0))) })
    }

    test "el grupo de una mesa se va cuando se cansa de esperar" {
        mesa.sentar(grupoDeUno)
        3.times({ i => mesa.esperar() })
        assert.that(mesa.grupoSeFue())
    }

    test "una mesa libre no tiene ningún grupo que se haya ido" {
        mesa.esperar()
        assert.notThat(mesa.grupoSeFue())
    }
}
