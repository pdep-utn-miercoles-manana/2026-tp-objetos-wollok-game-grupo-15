import src.estadosEspera.*
import src.clienteComportamiento.*
import src.restauranteEntorno.*
import src.comidasComportamiento.*

describe "Cliente" {
    const cliente = new Cliente(pedido = new Pedido(comidaPedida = carne))

    test "un cliente recién llegado espera en verde" {
        assert.equals(verde, cliente.estado())
    }

    test "con el tiempo pasa de verde a amarillo, naranja y rojo" {
        cliente.esperar()
        assert.equals(amarillo, cliente.estado())
        cliente.esperar()
        assert.equals(naranja, cliente.estado())
        cliente.esperar()
        assert.equals(rojo, cliente.estado())
    }

    test "al llegar a rojo se va" {
        3.times({ i => cliente.esperar() })
        assert.that(cliente.seVa())
    }

    test "antes de llegar a rojo no se va" {
        2.times({ i => cliente.esperar() })
        assert.notThat(cliente.seVa())
    }

    test "la propina baja a medida que espera" {
        const propinaInicial = cliente.propinaActual()
        cliente.esperar()
        assert.that(cliente.propinaActual() < propinaInicial)
    }

    test "si le sirven lo que pidió, deja la propina de su estado" {
        const comida = carne.copiarEn(game.at(0, 0))
        cliente.esperar()
        assert.equals(amarillo.propina(), cliente.atender(comida))
    }

    test "si le sirven otra cosa, no acepta" {
        assert.throwsExceptionWithMessage("El cliente no pidió esto", { cliente.atender(cerdo) })
    }
}

describe "Mesa" {
    const mesa = new Mesa(position = game.at(0, 0))
    const cliente = new Cliente(pedido = new Pedido(comidaPedida = carne))

    test "una mesa nueva está libre" {
        assert.notThat(mesa.ocupada())
    }

    test "al sentar un cliente, la mesa queda ocupada" {
        mesa.sentar(cliente)
        assert.that(mesa.ocupada())
    }

    test "no se puede sentar a un cliente en una mesa ocupada" {
        mesa.sentar(cliente)
        assert.throwsExceptionWithMessage("La mesa ya está ocupada", { mesa.sentar(cliente) })
    }

    test "servir devuelve la propina y libera la mesa" {
        mesa.sentar(cliente)
        const propina = mesa.servir(carne.copiarEn(game.at(0, 0)))
        assert.equals(verde.propina(), propina)
        assert.notThat(mesa.ocupada())
    }

    test "no se puede servir en una mesa libre" {
        assert.throwsExceptionWithMessage("No hay nadie en la mesa", { mesa.servir(carne) })
    }

    test "el cliente de una mesa se va cuando se cansa de esperar" {
        mesa.sentar(cliente)
        3.times({ i => mesa.esperar() })
        assert.that(mesa.clienteSeFue())
    }

    test "una mesa libre no tiene clientes que se hayan ido" {
        mesa.esperar()
        assert.notThat(mesa.clienteSeFue())
    }
}
